{
  "id": "generic-bar",
  "name": "Barras Genérico",
  "description": "Gráfico de barras animado desde cualquier consulta",
  "componentId": "GenericBar",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "defaultDuration": 10,
  "dataOptions": [
    {
      "key": "numberFormat",
      "label": "Formato de números",
      "type": "select",
      "options": [
        { "value": "short", "label": "Compacto" },
        { "value": "none", "label": "Entero" },
        { "value": "decimal", "label": "Decimal" },
        { "value": "percent", "label": "Porcentaje" },
        { "value": "currency", "label": "Moneda" }
      ],
      "default": "short"
    }
  ],
  "dataProfile": {
    "requiredColumns": ["label", "value"],
    "columnHints": {
      "label": ["text"],
      "value": ["number"]
    },
    "minRows": 1,
    "rowMatch": "at_least"
  }
}
