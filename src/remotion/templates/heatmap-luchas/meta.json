{
  "id": "heatmap-luchas",
  "name": "Heatmap de Luchas",
  "description": "Mapa de calor de luchas por categoría y período",
  "componentId": "HeatmapLuchas",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "defaultDuration": 10,
  "dataOptions": [
    {
      "key": "title",
      "label": "Título",
      "type": "text",
      "default": "Luchas por Año y Promoción"
    },
    {
      "key": "maxPromotions",
      "label": "Máx. promociones",
      "type": "number",
      "min": 1,
      "max": 20,
      "default": 8
    },
    {
      "key": "maxYears",
      "label": "Máx. años",
      "type": "number",
      "min": 1,
      "max": 15,
      "default": 7
    }
  ],
  "dataProfile": {
    "requiredColumns": ["row", "col", "value"],
    "columnHints": {
      "label": ["text"],
      "value": ["number"]
    },
    "minRows": 4,
    "rowMatch": "at_least"
  }
}