{
  "id": "stats-kpi",
  "name": "KPI / Estadística",
  "description": "Un solo número grande con label y descripción",
  "componentId": "StatsKpi",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "defaultDuration": 10,
  "dataOptions": [
    {
      "key": "kpi",
      "label": "Métrica",
      "type": "select",
      "options": [
        { "value": "events_count", "label": "Eventos" },
        { "value": "matches_count", "label": "Luchas" },
        { "value": "wrestlers_count", "label": "Luchadores" },
        { "value": "promotions_count", "label": "Promociones" },
        { "value": "titles_count", "label": "Títulos" },
        { "value": "stables_count", "label": "Estables" },
        { "value": "venues_count", "label": "Recintos" },
        { "value": "active_promotions_count", "label": "Promociones activas" }
      ],
      "default": "events_count"
    },
    {
      "key": "label",
      "label": "Label (opcional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "value",
      "label": "Valor manual (si no hay datos)",
      "type": "number",
      "default": 0
    },
    {
      "key": "suffix",
      "label": "Sufijo",
      "type": "text",
      "default": ""
    },
    {
      "key": "prefix",
      "label": "Prefijo",
      "type": "text",
      "default": ""
    },
    {
      "key": "description",
      "label": "Descripción",
      "type": "text",
      "default": ""
    }
  ],
  "dataProfile": {
    "requiredColumns": ["label", "value"],
    "columnHints": {
      "label": ["text"],
      "value": ["number"]
    },
    "minRows": 1,
    "maxRows": 1,
    "rowMatch": "exact"
  }
}